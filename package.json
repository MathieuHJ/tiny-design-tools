{
  "name": "tiny-design-tools",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm test && pnpm typecheck && pnpm build",
    "capture": "pnpm build && node scripts/capture-release.mjs",
    "capture:copy-stress": "pnpm build && node scripts/capture-copy-stress.mjs",
    "capture:proofs": "node scripts/capture-proofs.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "playwright": "1.55.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@11.8.0"
}
